<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key><string>Vita Heart</string>
  <key>CFBundleName</key><string>VitaHeartWatch</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>WKApplication</key><true/>
  <key>WKWatchOnly</key><true/>
  <key>NSHealthShareUsageDescription</key>
  <string>Vita Heart reads your heart rate during a seated session so it can be shown on your television.</string>
  <key>NSHealthUpdateUsageDescription</key>
  <string>Vita Heart records the session as a workout in Health.</string>
  <key>UIBackgroundModes</key><array><string>workout-processing</string></array>
</dict>
</plist>
